{
  "name": "lit-engine-editor",
  "version": "0.1.0",
  "description": "Standalone desktop editor for LitEngine",
  "author": "LitEngine",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "npm run dev:renderer",
    "dev:renderer": "vite",
    "dev:desktop": "concurrently --kill-others-on-fail \"npm run dev:renderer\" \"wait-on tcp:127.0.0.1:5173 && cross-env LIT_EDITOR_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run build:renderer",
    "build:engine": "npm --prefix .. run build:rel:esm",
    "build:renderer": "vite build",
    "package:win": "npm run build:engine && npm run build:renderer && electron-builder --win",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test test/**/*.test.mjs"
  },
  "dependencies": {
    "@playcanvas/pcui": "6.1.4",
    "playcanvas": "file:..",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playcanvas/eslint-config": "3.0.0-beta.8",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "vite": "8.3.0",
    "wait-on": "9.1.0"
  }
}
